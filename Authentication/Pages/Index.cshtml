<body class="hold-transition login-page">
<div class="login-box">
  @* <div class="login-logo">
    <a href="../../index2.html"><b></b></a>
  </div> *@
  <!-- /.login-logo -->
  <div class="card">
    <div class="card-body login-card-body">
      <h3><p class="login-box-msg">@ViewData["Title"]</p></h3>

      <form method="post"  >
        
        <div class="input-group mb-3">
          <input type="email" asp-for="ModelInput.EMAIL"  required class="form-control" placeholder="Email">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-envelope"></span>
            </div>
          </div>
        </div>
        <div class="input-group mb-3">
          <input type="password" asp-for="ModelInput.PASSWORD" required class="form-control" placeholder="Password">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-lock"></span>
            </div>
          </div>
        </div>
           
        <div class="row">
          <div class="col-8">
            <div class="icheck-primary">
              <input type="checkbox" asp-for="ModelInput.REMEMBERME" id="remember">
              <label for="remember">
                Remember Me
              </label>
            </div>
          </div>
          <!-- /.col -->
          <div class="col-4">
            <button type="submit" class="btn btn-success btn-block">Login</button>
          </div>
          <!-- /.col -->
        </div>
      </form>

      @* <div class="social-auth-links text-center mb-3">
        <p>- OR -</p>
        <a href="#" class="btn btn-block btn-primary">
          <i class="fab fa-facebook mr-2"></i> Sign in using Facebook
        </a>
        <a href="#" class="btn btn-block btn-danger">
          <i class="fab fa-google-plus mr-2"></i> Sign in using Google+
        </a>
      </div>
      <!-- /.social-auth-links --> *@

      @* <p class="mb-1">
        <a asp-page="/Account//ResetPassword">Olvide mi contraseña?</a>
      </p> *@
      <p class="mb-0">
        <div asp-validation-summary="ModelOnly" class="text-danger">
                            <a href="#" class="text-center">Invalid credentials. </a>
                        </div>
      </p>
      @* <p class="login-box-msg"><a href="https://syscrafter.com">Powered by SysCrafter</a></p> *@
    </div>
    <!-- /.login-card-body -->
  </div>
</div>
<!-- /.login-box -->


</body>


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}



